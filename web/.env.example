# Sui Move package ID (deployed hardened contract address)
NEXT_PUBLIC_PACKAGE_ID=0x0

# Admin hot wallet (server-side tx signing). NEVER commit the real value.
# Owns the TreasuryCap + AdminCap; used by the gas-free API routes.
ADMIN_PRIVATE_KEY=

# Google OAuth Client ID for zkLogin (server verifies tokens against Google JWKS).
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Long random string — derives per-user zkLogin salt. Required when zkLogin is on.
ZKLOGIN_SALT_SECRET=

# Redis (Upstash or Vercel KV) — required in production so faucet/claim dedup,
# payment replay protection, rate limiting, and battle rooms work across
# serverless instances. Without it, the in-memory fallback is per-instance only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
